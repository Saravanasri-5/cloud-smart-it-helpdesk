# Copy to .env and edit values
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=helpdesk_user
DB_PASSWORD=HelpdeskPass@123
DB_NAME=helpdesk_db
# Optional: overrides the DB_* values (e.g. sqlite:///helpdesk.db for a quick local test)
# DATABASE_URL=
UPLOAD_FOLDER=static/uploads
HOST=127.0.0.1
PORT=5000
# Default administrator created on first start when the users table is empty
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@helpdesk.local
ADMIN_PASSWORD=Admin@12345
